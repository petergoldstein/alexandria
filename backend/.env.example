# ===========================================
# Alexandria Backend Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# Database Connection
# For local development with Docker: postgresql+asyncpg://postgres:localdev@localhost:5432/alexandria
# For production: Use your hosted PostgreSQL connection string
DATABASE_URL=postgresql+asyncpg://postgres:localdev@localhost:5432/alexandria

# Security Keys (IMPORTANT: Generate unique values for production!)
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=your-encryption-key-here-change-in-production

# ===========================================
# Storage Backend Configuration
# ===========================================
# Choose one: "local", "s3", or "r2"
STORAGE_BACKEND=local

# Local Storage (for development)
# Directory where files are stored on the local filesystem
LOCAL_STORAGE_PATH=./storage

# AWS S3 (Optional - for production with AWS)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET_NAME=
S3_ENDPOINT_URL=
S3_REGION=us-east-1

# Cloudflare R2 (Optional - for production with R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=alexandria-files
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL_BASE=

# Application Settings
DEBUG=true
CORS_ORIGINS=["http://localhost:3000"]

# AI Provider API Keys (Optional - only for running test scripts)
# The actual API keys are added via the Settings page in the UI
# and stored encrypted in the database
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
